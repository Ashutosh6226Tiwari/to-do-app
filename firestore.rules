rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===============================================================
    // 1. users/{uid}
    // - Do NOT store email in users/{uid}; keep only public fields
    // - Allow get by uid for signed-in users, but DENY list so nobody can enumerate profiles
    // - First migration allows starting xp up to 100000; afterwards max +500 XP per write
    // - Sanity limits: currentStreak (0..3650), weeklyMinutes (0..10080), level must not drop
    // - Role is 'user' on creation and immutable by client writes (changed only in Firebase Console)
    // ===============================================================
    function hasAllowedUserFieldsOnly(data) {
      return data.keys().hasAll([
        'displayName',
        'photoURL',
        'username',
        'xp',
        'level',
        'currentStreak',
        'longestStreak',
        'totalMinutes',
        'weeklyMinutes',
        'weekKey',
        'studyingNow',
        'role',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'displayName',
        'photoURL',
        'username',
        'xp',
        'level',
        'currentStreak',
        'longestStreak',
        'totalMinutes',
        'weeklyMinutes',
        'weekKey',
        'studyingNow',
        'role',
        'createdAt'
      ]) &&
      !('email' in data);
    }

    function hasValidUserFieldTypesAndBounds(data) {
      return hasAllowedUserFieldsOnly(data) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 20 &&
        data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
        data.level is int && data.level >= 1 && data.level <= 500 &&
        data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 3650 &&
        data.longestStreak is int && data.longestStreak >= data.currentStreak && data.longestStreak <= 3650 &&
        data.totalMinutes is int && data.totalMinutes >= 0 && data.totalMinutes <= 5256000 &&
        data.weeklyMinutes is int && data.weeklyMinutes >= 0 && data.weeklyMinutes <= 10080 &&
        data.weekKey is string && data.weekKey.size() >= 6 && data.weekKey.size() <= 12 &&
        data.studyingNow is bool &&
        data.role in ['user', 'admin'] &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /users/{uid} {
      // Allow get by uid for signed-in users, but deny list to prevent profile enumeration
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if false;

      // First migration / creation: allow starting xp up to 100000, role must be 'user'
      allow create: if isOwner(uid) &&
        isValidId(uid) &&
        hasValidUserFieldTypesAndBounds(incoming()) &&
        incoming().role == 'user' &&
        incoming().xp <= 100000;

      // Subsequent updates: role, username, and createdAt cannot change;
      // XP can increase by at most 500 per write (and never decrease);
      // level and longestStreak must not drop.
      allow update: if isOwner(uid) &&
        isValidId(uid) &&
        hasValidUserFieldTypesAndBounds(incoming()) &&
        incoming().role == existing().role &&
        incoming().username == existing().username &&
        incoming().createdAt == existing().createdAt &&
        incoming().xp >= existing().xp &&
        (incoming().xp - existing().xp) <= 500 &&
        incoming().level >= existing().level &&
        incoming().longestStreak >= existing().longestStreak &&
        incoming().totalMinutes >= existing().totalMinutes;

      allow delete: if false;

      // Private user app state (tasks, timer settings, theme, dailyGoalHours)
      match /private/{docId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          isValidId(docId) &&
          incoming().keys().hasAll(['tasks', 'settings', 'theme']) &&
          incoming().keys().hasOnly(['tasks', 'settings', 'theme', 'dailyGoalHours']) &&
          incoming().tasks is list && incoming().tasks.size() <= 200 &&
          incoming().settings is map &&
          incoming().theme in ['calm', 'cozy', 'deep-focus', 'fresh', 'energetic'] &&
          (!('dailyGoalHours' in incoming()) ||
            ((incoming().dailyGoalHours is int || incoming().dailyGoalHours is float) &&
             incoming().dailyGoalHours >= 0 &&
             incoming().dailyGoalHours <= 16));
        allow delete: if isOwner(uid);
      }

      // Completed focus session logs:
      // minutes between 1 and 180, subject string under 100 chars, no extra fields
      function isValidSessionDoc(data) {
        return data.keys().hasAll(['minutes', 'subject', 'date', 'xpAwarded']) &&
          data.keys().hasOnly(['minutes', 'subject', 'date', 'xpAwarded']) &&
          data.minutes is int && data.minutes >= 1 && data.minutes <= 180 &&
          data.subject is string && data.subject.size() >= 1 && data.subject.size() < 100 &&
          data.date is string && data.date.size() == 10 &&
          data.xpAwarded is int && data.xpAwarded >= 0 && data.xpAwarded <= 500;
      }

      match /sessions/{sessionId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          isValidId(sessionId) &&
          isValidSessionDoc(incoming());
        allow delete: if isOwner(uid);
      }
    }

    // ===============================================================
    // 2. usernames/{usernameLower}
    // - Enforces unique usernames; cannot be overwritten or deleted once claimed
    // ===============================================================
    match /usernames/{usernameLower} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        usernameLower.size() >= 3 &&
        usernameLower.size() <= 20 &&
        usernameLower.matches('^[a-z0-9_]+$') &&
        !exists(/databases/$(database)/documents/usernames/$(usernameLower)) &&
        incoming().keys().hasAll(['uid']) &&
        incoming().keys().hasOnly(['uid']) &&
        incoming().uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===============================================================
    // 3. friendRequests/{requestId}
    // - requestId must be deterministic: fromUid + "_" + toUid
    // - Prevents sending to yourself or creating duplicate pending requests
    // - Only visible to sender (fromUid) or recipient (toUid)
    // ===============================================================
    match /friendRequests/{requestId} {
      allow get, list: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        incoming().keys().hasAll(['fromUid', 'toUid', 'status', 'createdAt']) &&
        incoming().keys().hasOnly(['fromUid', 'toUid', 'fromUsername', 'fromDisplayName', 'toUsername', 'status', 'createdAt']) &&
        incoming().fromUid == request.auth.uid &&
        incoming().toUid is string &&
        incoming().toUid != request.auth.uid &&
        requestId == (incoming().fromUid + '_' + incoming().toUid) &&
        incoming().status == 'pending' &&
        incoming().createdAt is string && incoming().createdAt.size() <= 40;

      allow update: if isSignedIn() &&
        existing().toUid == request.auth.uid &&
        existing().status == 'pending' &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().status in ['accepted', 'declined'];

      allow delete: if isSignedIn() &&
        (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // ===============================================================
    // 4. friendships/{friendshipId}
    // - May only be created by the accepting recipient after the corresponding
    //   friendRequest between the two users has status == 'accepted'
    // ===============================================================
    function hasAcceptedRequestForRecipient(uidA, uidB) {
      let reqAB = /databases/$(database)/documents/friendRequests/$(uidA + '_' + uidB);
      let reqBA = /databases/$(database)/documents/friendRequests/$(uidB + '_' + uidA);
      return (
        existsAfter(reqAB) &&
        getAfter(reqAB).data.fromUid == uidA &&
        getAfter(reqAB).data.toUid == uidB &&
        getAfter(reqAB).data.status == 'accepted' &&
        request.auth.uid == uidB
      ) || (
        existsAfter(reqBA) &&
        getAfter(reqBA).data.fromUid == uidB &&
        getAfter(reqBA).data.toUid == uidA &&
        getAfter(reqBA).data.status == 'accepted' &&
        request.auth.uid == uidA
      );
    }

    match /friendships/{friendshipId} {
      allow get, list: if isSignedIn() &&
        request.auth.uid in resource.data.members;

      allow create: if isSignedIn() &&
        isValidId(friendshipId) &&
        incoming().keys().hasAll(['members', 'createdAt']) &&
        incoming().keys().hasOnly(['members', 'createdAt']) &&
        incoming().members is list &&
        incoming().members.size() == 2 &&
        incoming().members[0] is string &&
        incoming().members[1] is string &&
        incoming().members[0] != incoming().members[1] &&
        friendshipId == (incoming().members[0] + '_' + incoming().members[1]) &&
        request.auth.uid in incoming().members &&
        incoming().createdAt is string && incoming().createdAt.size() <= 40 &&
        hasAcceptedRequestForRecipient(incoming().members[0], incoming().members[1]);

      allow update: if false;

      allow delete: if isSignedIn() &&
        request.auth.uid in existing().members;
    }

    // ===============================================================
    // 5. rooms/{code} and rooms/{code}/members/{uid}
    // - Only the host may change hostUid, startedAt, durationSec, focusMinutes,
    //   shortBreakMinutes, longBreakMinutes, mode, status, or remove other members.
    // - focusMinutes, shortBreakMinutes, longBreakMinutes must be 1..180 and
    //   may NEVER be changed while status is 'running'.
    // - A non-host may ONLY add or remove THEIR OWN uid in memberUids.
    // - Joining is refused when memberUids already has 10 members.
    // ===============================================================
    function hasValidRoomCustomDurations(data) {
      return (!('focusMinutes' in data) || (data.focusMinutes is int && data.focusMinutes >= 1 && data.focusMinutes <= 180)) &&
        (!('shortBreakMinutes' in data) || (data.shortBreakMinutes is int && data.shortBreakMinutes >= 1 && data.shortBreakMinutes <= 180)) &&
        (!('longBreakMinutes' in data) || (data.longBreakMinutes is int && data.longBreakMinutes >= 1 && data.longBreakMinutes <= 180));
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['hostUid', 'memberUids', 'maxMembers', 'mode', 'startedAt', 'durationSec', 'status']) &&
        data.keys().hasOnly([
          'hostUid',
          'memberUids',
          'maxMembers',
          'mode',
          'startedAt',
          'durationSec',
          'focusMinutes',
          'shortBreakMinutes',
          'longBreakMinutes',
          'status',
          'createdAt'
        ]) &&
        data.hostUid is string &&
        data.memberUids is list &&
        data.memberUids.size() >= 1 &&
        data.memberUids.size() <= 10 &&
        data.hostUid in data.memberUids &&
        data.maxMembers == 10 &&
        data.mode in ['focus', 'shortBreak', 'longBreak'] &&
        (data.startedAt == null || (data.startedAt is int && data.startedAt >= 0)) &&
        data.durationSec is int && data.durationSec >= 10 && data.durationSec <= 10800 &&
        hasValidRoomCustomDurations(data) &&
        data.status in ['idle', 'running', 'paused', 'completed'];
    }

    // Host update guard: only host can change timer/settings, and focusMinutes/shortBreakMinutes/longBreakMinutes
    // can NEVER be changed while existing().status == 'running'
    function isHostRoomUpdateValid() {
      return existing().hostUid == request.auth.uid &&
        (
          existing().status != 'running' ||
          (
            incoming().get('focusMinutes', 25) == existing().get('focusMinutes', 25) &&
            incoming().get('shortBreakMinutes', 5) == existing().get('shortBreakMinutes', 5) &&
            incoming().get('longBreakMinutes', 15) == existing().get('longBreakMinutes', 15)
          )
        );
    }

    function isSelfJoinOnly() {
      return !(request.auth.uid in existing().memberUids) &&
        existing().memberUids.size() < 10 &&
        incoming().diff(existing()).affectedKeys().hasOnly(['memberUids']) &&
        incoming().memberUids.size() == existing().memberUids.size() + 1 &&
        incoming().memberUids.hasAll(existing().memberUids) &&
        (request.auth.uid in incoming().memberUids);
    }

    function isSelfLeaveOnly() {
      return (request.auth.uid in existing().memberUids) &&
        existing().hostUid != request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['memberUids']) &&
        !(request.auth.uid in incoming().memberUids) &&
        incoming().memberUids.size() == existing().memberUids.size() - 1 &&
        existing().memberUids.hasAll(incoming().memberUids);
    }

    match /rooms/{code} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
        code.size() == 6 &&
        isValidRoom(incoming()) &&
        incoming().hostUid == request.auth.uid &&
        incoming().memberUids == [request.auth.uid];

      allow update: if isSignedIn() &&
        code.size() == 6 &&
        isValidRoom(incoming()) &&
        (
          isHostRoomUpdateValid() ||
          isSelfJoinOnly() ||
          isSelfLeaveOnly()
        );

      allow delete: if isSignedIn() && existing().hostUid == request.auth.uid;

      match /members/{memberUid} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() &&
          request.auth.uid == memberUid &&
          incoming().keys().hasAll(['name', 'photoURL', 'status', 'joinedAt']) &&
          incoming().keys().hasOnly(['name', 'photoURL', 'status', 'joinedAt']) &&
          incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 80 &&
          incoming().photoURL is string && incoming().photoURL.size() <= 500 &&
          incoming().status in ['focusing', 'break', 'idle'] &&
          incoming().joinedAt is string && incoming().joinedAt.size() <= 40;
        allow delete: if isSignedIn() &&
          (request.auth.uid == memberUid ||
           get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid);
      }
    }

    // ===============================================================
    // 6. tracks/{trackId}
    // - Readable by all signed-in users; writable ONLY by admins
    // - title < 100 chars, category in fixed list, url must start with https://
    // ===============================================================
    function isValidTrack(data) {
      return data.keys().hasAll(['title', 'category', 'url', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'url', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() < 100 &&
        data.category in ['Lo-Fi', 'Nature', 'Classical', 'Ambient', 'White Noise', 'Instrumental'] &&
        data.url is string && data.url.size() >= 10 && data.url.size() <= 500 &&
        data.url.matches('^https://.*') &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /tracks/{trackId} {
      allow get, list: if true;
      allow create, update: if isAdmin() &&
        isValidId(trackId) &&
        isValidTrack(incoming());
      allow delete: if isAdmin() && isValidId(trackId);
    }
  }
}
